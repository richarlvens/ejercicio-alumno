alumno = {
    "nombre " : input("nombre"),
    "telefono" : int(input("telefono")),
    "email" : input("email"),
    "edad" : int(input("edad"))
}

while True:
  print("===MENU===")
  print("[1] ver ficha")
  print("[2] editar datos")
  print("[3] salir")

  opc = int(input("ingrese una opcion"))

  if opc == 1:

    print(alumno)

  elif opc == 2:
    editar = input("que deseas editar ? : ")
    nuevo = input("ingrese el nuevo dato : ")
    alumno[editar] = nuevo


  elif opc == 3:
    print("saliendo")

    break

    print(alumno)

